<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="UTF-8">
    <title>Quản Lý Doanh Thu</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <!-- Thêm thẻ style này vào để làm thanh cuộn chuyên nghiệp -->
    <style>
        .table-responsive-container {
            max-height: 450px;
            overflow-y: auto;
            position: relative;
        }

        .table-responsive-container thead th {
            position: sticky;
            top: 0;
            background-color: #212529;
            color: white;
            z-index: 1;
        }
    </style>
</head>

<body class="bg-light">
    <div class="container mt-4">
        <a href="/" class="btn btn-secondary mb-3">&larr; Quay lại Trang chủ</a>
        <h2 class="text-success mb-3">Quản Lý Doanh Thu</h2>

        <!-- Form Thêm Doanh Thu Thủ Công -->
        <div class="card shadow mb-4 p-3">
            <h5 class="text-secondary mb-3">Thêm Khoản Thu Khác (Thủ công)</h5>
            <form action="/revenues/add" method="POST" class="row g-3">
                <div class="col-md-3">
                    <label class="form-label">Số tiền (VNĐ)</label>
                    <input type="number" step="any" name="amount" class="form-control" required
                        placeholder="VD: 500000">
                </div>
                <div class="col-md-3">
                    <label class="form-label">Nguồn thu / Danh mục</label>
                    <input type="text" name="category" class="form-control" required
                        placeholder="VD: Thu nhập ngoài...">
                </div>
                <div class="col-md-2">
                    <label class="form-label">Ngày thu</label>
                    <input type="date" name="date" class="form-control" required
                        value="<%= new Date().toISOString().split('T')[0] %>">
                </div>
                <div class="col-md-3">
                    <label class="form-label">Ghi chú</label>
                    <input type="text" name="note" class="form-control" placeholder="Ghi chú thêm...">
                </div>
                <div class="col-md-1 d-flex align-items-end">
                    <button type="submit" class="btn btn-success w-100">Thêm</button>
                </div>
            </form>
        </div>

        <!-- Bộ lọc và Xuất Excel -->
        <div class="card shadow p-3 mb-4">
            <form action="/revenues" method="GET" class="row g-3 align-items-end">
                <div class="col-md-3">
                    <label class="form-label">Từ ngày:</label>
                    <input type="date" name="from" class="form-control"
                        value="<%= typeof from !== 'undefined' ? from : '' %>" id="filterFrom">
                </div>
                <div class="col-md-3">
                    <label class="form-label">Đến ngày:</label>
                    <input type="date" name="to" class="form-control" value="<%= typeof to !== 'undefined' ? to : '' %>"
                        id="filterTo">
                </div>
                <div class="col-md-6 d-flex gap-2 align-items-center">
                    <button type="submit" class="btn btn-success">Lọc</button>
                    <a href="/revenues" class="btn btn-outline-secondary">Tất cả</a>

                    <!-- Nút Xuất Excel bám theo bộ lọc -->
                    <a href="#" id="exportExcelBtn" class="btn btn-outline-success ms-auto">📊 Xuất Excel</a>
                </div>
            </form>
        </div>

        <!-- Bảng danh sách doanh thu -->
        <div class="card shadow p-3">
            <% let totalAmount=0; if (revenues && revenues.length> 0) {
                revenues.forEach(item => {
                totalAmount += Number(item.amount) || 0;
                });
                }
                %>
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h4 class="mb-0">Danh Sách Doanh Thu Tổng Hợp</h4>
                    <span class="badge bg-success fs-6">Tổng doanh thu: <%= totalAmount.toLocaleString('vi-VN') %>
                            đ</span>
                </div>
                <div class="table-responsive-container">
                    <table class="table table-striped mt-2 align-middle">
                        <thead>
                            <tr>
                                <th>Ngày</th>
                                <th>Nguồn Thu / Phân Loại</th>
                                <th>Số Tiền</th>
                                <th>Ghi Chú</th>
                                <th>Hành động</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if(!revenues || revenues.length===0) { %>
                                <tr>
                                    <td colspan="5" class="text-center text-muted">Chưa có dữ liệu doanh thu nào.</td>
                                </tr>
                                <% } else { %>
                                    <% revenues.forEach(item=> { %>
                                        <tr>
                                            <td>
                                                <%= item.date %>
                                            </td>
                                            <td>
                                                <strong>
                                                    <%= item.category %>
                                                </strong>
                                                <% if (item.invoice_code) { %>
                                                    <br><span class="badge bg-info text-dark">Từ Đơn Hàng: <%=
                                                            item.invoice_code %></span>
                                                    <% } else { %>
                                                        <br><span class="badge bg-secondary">Thủ công</span>
                                                        <% } %>
                                            </td>
                                            <td class="text-success fw-bold">+ <%=
                                                    Number(item.amount).toLocaleString('vi-VN') %> đ</td>
                                            <td>
                                                <%= item.note || '' %>
                                            </td>
                                            <td>
                                                <% if (item.sale_id) { %>
                                                    <span class="text-muted small fst-italic">Quản lý tại Đơn
                                                        Hàng</span>
                                                    <% } else { %>
                                                        <!-- Dùng data attributes để tránh lỗi cú pháp EJS / JS string -->
                                                        <button type="button" class="btn btn-sm btn-warning btn-edit"
                                                            data-id="<%= item.id %>" data-amount="<%= item.amount %>"
                                                            data-category="<%= item.category %>"
                                                            data-note="<%= item.note || '' %>"
                                                            data-date="<%= item.date %>">Sửa</button>
                                                        <form action="/revenues/delete/<%= item.id %>" method="POST"
                                                            style="display:inline;"
                                                            onsubmit="return confirm('Xóa khoản thu thủ công này chứ?');">
                                                            <button type="submit"
                                                                class="btn btn-sm btn-danger">Xóa</button>
                                                        </form>
                                                        <% } %>
                                            </td>
                                        </tr>
                                        <% }) %>
                                            <tr class="table-success fw-bold">
                                                <td colspan="2" class="text-end">TỔNG CỘNG:</td>
                                                <td colspan="3" class="text-success fs-5">+ <%=
                                                        totalAmount.toLocaleString('vi-VN') %> đ</td>
                                            </tr>
                                            <% } %>
                        </tbody>
                    </table>
                </div>

        </div>
    </div>

    <!-- Modal Sửa Doanh Thu -->
    <div class="modal fade" id="editRevenueModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <form id="editRevenueForm" method="POST">
                    <div class="modal-header">
                        <h5 class="modal-title">Cập Nhật Doanh Thu</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label">Số Tiền (VNĐ)</label>
                            <input type="number" class="form-control" name="amount" id="edit_rev_amount" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Phân Loại</label>
                            <input type="text" class="form-control" name="category" id="edit_rev_category" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Ghi Chú</label>
                            <textarea class="form-control" name="note" id="edit_rev_note"></textarea>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Ngày</label>
                            <input type="date" class="form-control" name="date" id="edit_rev_date" required>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                        <button type="submit" class="btn btn-primary">Lưu Thay Đổi</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Bootstrap JS và Script xử lý -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Xử lý sự kiện click nút Sửa an toàn bằng dataset
        document.querySelectorAll('.btn-edit').forEach(button => {
            button.addEventListener('click', function () {
                const id = this.getAttribute('data-id');
                const amount = this.getAttribute('data-amount');
                const category = this.getAttribute('data-category');
                const note = this.getAttribute('data-note');
                const date = this.getAttribute('data-date');

                document.getElementById('editRevenueForm').action = '/revenues/edit/' + id;
                document.getElementById('edit_rev_amount').value = amount;
                document.getElementById('edit_rev_category').value = category;
                document.getElementById('edit_rev_note').value = note;
                document.getElementById('edit_rev_date').value = date;

                var myModal = new bootstrap.Modal(document.getElementById('editRevenueModal'));
                myModal.show();
            });
        });

        // Đồng bộ khoảng thời gian bộ lọc vào nút Xuất Excel
        document.getElementById('exportExcelBtn').addEventListener('click', function (e) {
            e.preventDefault();
            const from = document.getElementById('filterFrom').value;
            const to = document.getElementById('filterTo').value;

            let url = '/revenues/export?';
            if (from) url += 'from=' + from + '&';
            if (to) url += 'to=' + to;

            window.location.href = url;
        });
    </script>
</body>

</html>