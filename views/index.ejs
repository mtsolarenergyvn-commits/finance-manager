<!DOCTYPE html>
<html lang="<%= currentLang %>">

<head>
    <meta charset="UTF-8">
    <title>
        <%= t.brand %>
    </title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <style>
        .card-equal {
            transition: transform 0.2s;
            border-radius: 12px;
        }

        .card-equal:hover {
            transform: translateY(-5px);
        }

        .logo-img {
            max-height: 50px;
            object-fit: contain;
        }
    </style>
</head>

<body class="bg-light">
    <div class="container mt-4 mb-5">

        <!-- TOP BAR: Logo công ty & Thanh chọn Ngôn ngữ -->
        <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
            <div class="d-flex align-items-center gap-3">
                <img src="/images/logo-mt-solar.png" alt="MT Solar Logo" class="logo-img"
                    onerror="this.style.display='none'">
                <h4 class="fw-bold text-dark m-0">MT SOLAR</h4>
            </div>

            <!-- Nút chọn ngôn ngữ (Việt - Anh - Trung) -->
            <div class="btn-group shadow-sm">
                <a href="/lang/vi"
                    class="btn btn-sm <%= currentLang === 'vi' ? 'btn-primary' : 'btn-outline-primary' %>">Tiếng
                    Việt</a>
                <a href="/lang/en"
                    class="btn btn-sm <%= currentLang === 'en' ? 'btn-primary' : 'btn-outline-primary' %>">English</a>
                <a href="/lang/cn"
                    class="btn btn-sm <%= currentLang === 'cn' ? 'btn-danger' : 'btn-outline-danger' %>">中文 (Sếp)</a>
            </div>

            <!-- Nút mở Modal Đổi Mật Khẩu -->
            <button type="button" class="btn btn-sm btn-outline-warning fw-semibold" data-bs-toggle="modal"
                data-bs-target="#changePasswordModal">
                🔒 Đổi Mật Khẩu
            </button>

            <!-- Nút Đăng Xuất -->
            <a href="/logout" class="btn btn-sm btn-outline-danger fw-semibold"
                onclick="return confirm('Bạn có chắc chắn muốn đăng xuất không?');">
                🚪 Đăng Xuất
            </a>
        </div>

        <!-- MODAL ĐỔI MẬT KHẨU -->
        <div class="modal fade" id="changePasswordModal" tabindex="-1" aria-labelledby="changePasswordModalLabel"
            aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <form action="/change-password" method="POST">
                        <div class="modal-header bg-warning text-dark">
                            <h5 class="modal-title fw-bold" id="changePasswordModalLabel">🔐 Đổi Mật Khẩu Hệ Thống</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Mật khẩu cũ:</label>
                                <input type="password" class="form-control" name="oldPassword" required
                                    placeholder="Nhập mật khẩu hiện tại...">
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Mật khẩu mới:</label>
                                <input type="password" class="form-control" name="newPassword" required
                                    placeholder="Nhập mật khẩu mới...">
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Hủy</button>
                            <button type="submit" class="btn btn-warning btn-sm fw-bold">Xác Nhận Đổi</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- Tiêu đề tổng -->
        <div class="text-center my-4">
            <h2 class="fw-bold text-uppercase text-secondary" style="letter-spacing: 1px;">
                <%= t.brand %>
            </h2>
        </div>

        <!-- 4 Ô chức năng cân bằng bố cục -->
        <div class="row g-4 mt-2">
            <!-- 1. Quản lý bán hàng -->
            <div class="col-md-3">
                <div
                    class="card card-equal shadow-sm h-100 border-warning border-2 p-3 d-flex flex-column justify-content-between text-center">
                    <div>
                        <h4 class="fw-bold text-dark mb-3">
                            <%= t.salesTitle %>
                        </h4>
                        <p class="text-muted small">
                            <%= t.salesDesc %>
                        </p>
                    </div>
                    <div class="mt-3">
                        <a href="/sales" class="btn btn-warning text-white fw-bold w-100 py-2">
                            <%= t.salesBtn %>
                        </a>
                    </div>
                </div>
            </div>

            <!-- 2. Quản lý doanh thu -->
            <div class="col-md-3">
                <div
                    class="card card-equal shadow-sm h-100 border-success border-2 p-3 d-flex flex-column justify-content-between text-center">
                    <div>
                        <h4 class="fw-bold text-dark mb-3">
                            <%= t.revTitle %>
                        </h4>
                        <p class="text-muted small">
                            <%= t.revDesc %>
                        </p>
                    </div>
                    <div class="mt-3">
                        <a href="/revenues" class="btn btn-success fw-bold w-100 py-2">
                            <%= t.revBtn %>
                        </a>
                    </div>
                </div>
            </div>

            <!-- 3. Quản lý chi phí -->
            <div class="col-md-3">
                <div
                    class="card card-equal shadow-sm h-100 border-danger border-2 p-3 d-flex flex-column justify-content-between text-center">
                    <div>
                        <h4 class="fw-bold text-dark mb-3">
                            <%= t.expTitle %>
                        </h4>
                        <p class="text-muted small">
                            <%= t.expDesc %>
                        </p>
                    </div>
                    <div class="mt-3">
                        <a href="/expenses" class="btn btn-danger fw-bold w-100 py-2">
                            <%= t.expBtn %>
                        </a>
                    </div>
                </div>
            </div>

            <!-- 4. Báo cáo lợi nhuận -->
            <div class="col-md-3">
                <div
                    class="card card-equal shadow-sm h-100 border-primary border-2 p-3 d-flex flex-column justify-content-between text-center">
                    <div>
                        <h4 class="fw-bold text-dark mb-3">
                            <%= t.profTitle %>
                        </h4>
                        <p class="text-muted small">
                            <%= t.profDesc %>
                        </p>
                    </div>
                    <div class="mt-3">
                        <a href="/profit" class="btn btn-primary fw-bold w-100 py-2">
                            <%= t.profBtn %>
                        </a>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <!-- Bootstrap 5 JS Bundle (BẮT BUỘC ĐỂ MODAL HOẠT ĐỘNG) -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>