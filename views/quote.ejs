<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="UTF-8">
    <title>Tạo Báo Giá Nhanh - Cty TNHH MT Solar Energy</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>

<body class="bg-light">
    <div class="container mt-4 mb-5" style="max-width: 900px;">
        <!-- Thanh điều hướng -->
        <div class="d-flex justify-content-between align-items-center mb-4">
            <a href="/sales" class="btn btn-secondary">&larr; Quay lại Quản Lý Bán Hàng</a>
            <h3 class="fw-bold text-success m-0"><i class="fas fa-file-contract"></i> Lập Báo Giá Nhanh</h3>
        </div>

        <!-- Form nhập liệu báo giá -->
        <form action="/quote/print" method="POST" target="_blank">
            <div class="card shadow-sm p-4 border-success">
                <h5 class="text-success mb-3 fw-bold"><i class="fas fa-info-circle"></i> Thông Tin Khách Hàng & Báo Giá
                </h5>

                <div class="row mb-3">
                    <!-- Ô nhập tên nhân viên lập phiếu -->
                    <div class="col-md-6">
                        <label class="form-label fw-bold" style="font-size: 0.9rem;">Nhân viên lập phiếu / Phụ
                            trách:</label>
                        <input type="text" name="employee" class="form-control" placeholder="Nhập tên nhân viên..."
                            value="<%= typeof currentUser !== 'undefined' ? currentUser : '' %>" required>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Tên Khách Hàng / Công Ty:</label>
                            <input type="text" class="form-control" name="customerName"
                                placeholder="Nhập tên khách hàng hoặc đơn vị..." required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Mã Số Thuế (nếu có):</label>
                            <input type="text" class="form-control" name="customerTaxCode"
                                placeholder="Mã số thuế khách hàng">
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-4">
                            <label class="form-label small fw-bold">Số Điện Thoại:</label>
                            <input type="text" class="form-control" name="customerPhone" placeholder="SĐT liên hệ">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold">Ngày Báo Giá:</label>
                            <input type="date" class="form-control" name="quoteDate" required
                                value="<%= new Date().toISOString().split('T')[0] %>">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold">Hiệu Lực Đến Ngày:</label>
                            <input type="date" class="form-control" name="validUntil"
                                value="<%= new Date(Date.now() + 7*24*60*60*1000).toISOString().split('T')[0] %>">
                        </div>
                    </div>

                    <hr class="my-4">

                    <h5 class="text-success mb-3 fw-bold"><i class="fas fa-boxes"></i> Danh Sách Sản Phẩm / Thiết Bị Báo
                        Giá
                    </h5>

                    <div id="quote-rows-container">
                        <div class="row quote-item mb-2 align-items-center">
                            <div class="col-md-4">
                                <input type="text" class="form-control form-control-sm" name="products[]"
                                    placeholder="Tên thiết bị / sản phẩm" required>
                            </div>
                            <div class="col-md-2">
                                <input type="text" class="form-control form-control-sm" name="units[]"
                                    placeholder="ĐVT (Bộ/Tấm/Cái)" value="Bộ">
                            </div>
                            <div class="col-md-2">
                                <input type="number" class="form-control form-control-sm qty" name="quantities[]"
                                    placeholder="SL" value="1" min="1" required oninput="calcQuoteRow(this)">
                            </div>
                            <div class="col-md-2">
                                <input type="number" class="form-control form-control-sm price" name="unitPrices[]"
                                    placeholder="Đơn giá (VNĐ)" required oninput="calcQuoteRow(this)">
                            </div>
                            <div class="col-md-2 d-flex">
                                <input type="number" class="form-control form-control-sm amt me-1" name="amounts[]"
                                    placeholder="Thành tiền" readonly required>
                                <button type="button" class="btn btn-outline-danger btn-sm"
                                    onclick="removeQuoteRow(this)" disabled><i class="fas fa-trash"></i></button>
                            </div>
                        </div>
                    </div>

                    <div class="mt-2 mb-4">
                        <button type="button" class="btn btn-outline-success btn-sm" onclick="addQuoteRow()">
                            <i class="fas fa-plus"></i> Thêm dòng sản phẩm
                        </button>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Ghi chú thêm (Điều khoản thanh toán, bảo
                                hành...):</label>
                            <textarea class="form-control" name="note" rows="3"
                                placeholder="Ví dụ: Thanh toán 50% khi đặt cọc, bảo hành chính hãng 12 tháng..."></textarea>
                        </div>
                        <div class="row mb-3 align-items-center">
                            <div class="col-md-4">
                                <label class="form-label small fw-bold">Thuế VAT (%):</label>
                                <select class="form-select form-select-sm" name="vatRate" id="vat-rate"
                                    onchange="updateQuoteGrandTotal()">
                                    <option value="0">Không VAT (0%)</option>
                                    <option value="8">VAT 8%</option>
                                    <option value="10" selected>VAT 10%</option>
                                </select>
                            </div>
                            <div class="col-md-8 text-end d-flex flex-column justify-content-center">
                                <span class="text-muted small">Tổng tiền hàng: <span id="sub-total">0 VNĐ</span></span>
                                <span class="text-muted small">Tiền thuế VAT: <span id="vat-amount">0 VNĐ</span></span>
                                <h3 id="quote-grand-total" class="fw-bold text-success m-0">0 VNĐ</h3>
                            </div>
                        </div>
                        <div class="col-md-6 text-end d-flex flex-column justify-content-center">
                            <span class="text-muted">Tổng cộng tiền hàng:</span>
                            <h3 id="quote-grand-total" class="fw-bold text-success">0 VNĐ</h3>
                        </div>
                    </div>

                    <div class="text-end border-top pt-3">
                        <button type="submit" class="btn btn-success fw-bold px-5 py-2 shadow">
                            <i class="fas fa-print"></i> Xem & In Báo Giá
                        </button>
                    </div>
                </div>
        </form>
    </div>

    <!-- Script tính toán động báo giá -->
    <script>
        function addQuoteRow() {
            const container = document.getElementById('quote-rows-container');
            const firstRow = container.querySelector('.quote-item');
            const newRow = firstRow.cloneNode(true);

            newRow.querySelectorAll('input').forEach(input => {
                if (input.name === 'quantities[]') input.value = '1';
                else if (input.name === 'units[]') input.value = 'Bộ';
                else input.value = '';
            });
            newRow.querySelector('.btn-outline-danger').removeAttribute('disabled');
            container.appendChild(newRow);
        }

        function removeQuoteRow(btn) {
            btn.closest('.quote-item').remove();
            updateQuoteGrandTotal();
        }

        function calcQuoteRow(input) {
            const row = input.closest('.quote-item');
            const qty = parseFloat(row.querySelector('.qty').value) || 0;
            const price = parseFloat(row.querySelector('.price').value) || 0;
            const total = qty * price;

            row.querySelector('.amt').value = Math.round(total);
            updateQuoteGrandTotal();
        }

        function updateQuoteGrandTotal() {
            let subTotal = 0;
            document.querySelectorAll('.quote-item').forEach(row => {
                const amt = parseFloat(row.querySelector('.amt').value) || 0;
                subTotal += amt;
            });

            const vatRate = parseFloat(document.getElementById('vat-rate').value) || 0;
            const vatAmount = subTotal * (vatRate / 100);
            const grandTotal = subTotal + vatAmount;

            document.getElementById('sub-total').innerText = subTotal.toLocaleString() + ' VNĐ';
            document.getElementById('vat-amount').innerText = vatAmount.toLocaleString() + ' VNĐ';
            document.getElementById('quote-grand-total').innerText = grandTotal.toLocaleString() + ' VNĐ';
        }
    </script>
</body>

</html>